option.SHADOW_QUALITY=Shadow quality
option.SHADOW_QUALITY.comment=Shadow cascades: low (1), medium (3), high (4), ultra (4 with 16-tap PCF).
value.SHADOW_QUALITY.0=Low
value.SHADOW_QUALITY.1=Medium
value.SHADOW_QUALITY.2=High
value.SHADOW_QUALITY.3=Ultra
option.shadowMapResolution=Shadow atlas resolution
option.shadowMapResolution.comment=The atlas holds 4 cascades (2x2). 4096 = 2048 per cascade.
option.CLOUD_SHADOWS=Cloud shadows
option.TEXEL_SHADOWS=Pixel shadows (1/16 texel)
option.TEXEL_SHADOWS.comment=Pixel-art shadows: every 1/16 block texel gets a single, unfiltered shadow value.
option.SHADOW_SUN_STEP=Shadow sun step
option.SHADOW_SUN_STEP.comment=Shadows follow the sun in small steps (ticks) and never slide back between them. 0 = every frame (may flicker).
value.SHADOW_SUN_STEP.0=Continuous
value.SHADOW_SUN_STEP.20=20 ticks (1 s)
value.SHADOW_SUN_STEP.40=40 ticks (2 s)
value.SHADOW_SUN_STEP.80=80 ticks (4 s)
option.SHADOW_NORMAL_OFFSET=Normal offset
option.SHADOW_BIAS_SCALE=Shadow bias
option.SSS_CONTRIBUTION=Subsurface (leaves/plants)
option.SSS_FALLOFF=Subsurface falloff
option.DIFFUSE_WRAP=Diffuse wrap
option.VOLUMETRIC_FOG=Volumetric fog / god rays
option.VOLUME_QUALITY=Froxel quality
value.VOLUME_QUALITY.0=Low
value.VOLUME_QUALITY.1=Medium
value.VOLUME_QUALITY.2=High
value.VOLUME_QUALITY.3=Ultra
option.VOLUME_TEMPORAL=Temporal accumulation
option.FOG_DENSITY_MUL=Fog density
option.MICRO_DETAIL=Micro detail (per-texel bevel)
option.MICRO_DETAIL_STRENGTH=Micro detail strength
option.PBR_TABLE=Per-block PBR table
option.SUN_GLARE_SHAPE=Sunrise / Sunset Glow
option.SUN_GLARE_SHAPE.comment=Wide: the warm glow over the whole sun side of the horizon at sunrise and sunset, as the target look. Small: a small halo around the sun.
value.SUN_GLARE_SHAPE.0=Small
value.SUN_GLARE_SHAPE.1=Wide
option.DAY_CLOCK_PHASE=Day Follows the Clock
option.DAY_CLOCK_PHASE.comment=On: the sky colours and the light of the sun and moon follow the time of day, as the target look (nightfall at 13000 is night). Off: they follow the sun's position.
option.CLOUD_PROBE=Clouds in Reflections
option.CLOUD_PROBE.comment=Soft: clouds are reflected from the sky probe, blurred by distance, as the target look. Off: sharp, picked from the screen.
option.VOL_BLOCK_LIGHT=Block Light in Fog
option.VOL_BLOCK_LIGHT.comment=Torches, lamps and other lights light the volumetric fog around them, in their colour, as the target look. Needs Coloured Light.
option.VOL_SKY_VISIBILITY=Sky Visibility in Fog
option.VOL_SKY_VISIBILITY.comment=On: the fog's sky light and sun shafts follow how much sky each point of it sees (under trees, in a cave mouth), as the target look. Off: the sky light at the camera.
option.CLOUD_MODEL=Cloud Model
option.CLOUD_MODEL.comment=Target look: light follows the real paths through the cloud cells and clouds are see-through, as in the target look (Cloud Solar Rim is then part of it). Classic: slab lighting plus the Cloud Solar Rim.
value.CLOUD_MODEL.0=Classic
value.CLOUD_MODEL.1=Target look
option.PBR_FORMAT=PBR Format
option.PBR_FORMAT.comment=The layout of your PBR resource pack. Shiroi: packs made for this shader. LabPBR: most PBR resource packs (emission in the specular alpha, metals by F0). With the wrong one a LabPBR pack loses its glowing parts and its metals glow.
value.PBR_FORMAT.0=Shiroi
value.PBR_FORMAT.1=LabPBR
option.EMISSIVE_STRENGTH=Emissive strength
option.HAND_LIGHT=Held light
option.HAND_LIGHT.comment=A torch, a lantern or another light in your hands lights up the area around you, in its own colour.
